# Version
CONFIG_LOCALVERSION="-[Re]Shinomiya"
# CONFIG_LOCALVERSION_AUTO is not set

# TMPFS Support
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# Disable BORE
# CONFIG_SCHED_BORE is not set

