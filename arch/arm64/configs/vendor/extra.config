# Version
CONFIG_LOCALVERSION="-[Re]Shinomiya"
# CONFIG_LOCALVERSION_AUTO is not set

# TMPFS Support
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# Disable BORE
# CONFIG_SCHED_BORE is not set

# ThinLTO
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO_CLANG_THIN=y

# GMS Override
CONFIG_UNAME_SPOOF=y
CONFIG_UNAME_SPOOF_RELEASE="5.10.236-android12-9-00003-gfb24cf99ad97-ab14313284"
CONFIG_UNAME_SPOOF_VERSION="#1 SMP PREEMPT Tue Oct 21 03:03:12 UTC 2025"

# KernelSU
#
CONFIG_KSU=y
# CONFIG_KPM is not set
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_TRACEPOINT_HOOK=n
CONFIG_KSU_KPROBES_HOOK=n
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_MULTI_MANAGER_SUPPORT is not set
# CONFIG_KSU_ALLOWLIST_WORKAROUND is not set
# CONFIG_KSU_CMDLINE is not set
CONFIG_KSU_LSM_SECURITY_HOOKS=y

#
# KernelSU - SUSFS
#
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_SU=n

# end of KernelSU - SUSFS
# end of KernelSU
